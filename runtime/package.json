{
  "name": "@primeuicom/mcp",
  "version": "1.3.2",
  "description": "MCP server that connects AI agents with PrimeUI project",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "primeui",
    "ai-agent",
    "agent-tools",
    "developer-tools",
    "nextjs",
    "export",
    "website ai generation",
    "next.js ai generation",
    "ai sitebuilder",
    "primeui components",
    "primeui pages"
  ],
  "author": {
    "name": "Oleg",
    "email": "oleg@primeui.com",
    "url": "https://pixelpoint.io/"
  },
  "homepage": "https://primeui.com/",
  "repository": "https://primeui.com/",
  "bugs": {
    "url": "https://primeui.com/",
    "email": "oleg@primeui.com"
  },
  "type": "module",
  "main": "dist/service.js",
  "bin": {
    "primeui-mcp": "dist/service.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && pnpm run build:ui && tsup --config tsup.config.ts && chmod 755 dist/service.js",
    "build:ui": "vite build --config vite.ui.config.ts",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm run build:ui && tsx src/service.ts",
    "test": "vitest run --exclude 'tests/**'",
    "test:browser": "pnpm run build && playwright test --config playwright.config.ts",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector tsx src/service.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.511.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "5.8.2",
    "vite": "^8.0.8",
    "vitest": "^3.2.3"
  }
}
